app:
  name: agentcanvas
  env: local
  port: 8080
  base_url: http://localhost:8080
  cors_allowed_origins:
    - http://localhost:8080
    - http://localhost:5173

mysql:
  dsn: ${AGENTCANVAS_MYSQL_DSN}
  max_open_conns: 20
  max_idle_conns: 10

redis:
  addr: localhost:6379
  password: ${AGENTCANVAS_REDIS_PASSWORD}
  db: 0

queue:
  backend: nats # mysql, redis_stream, or nats
  redis_stream: agentcanvas:jobs
  redis_group: agentcanvas-workers
  redis_consumer: worker

durable_memory:
  enabled: false
  # Six hours of inactivity is the default extraction boundary.
  idle_timeout_seconds: 21600

nats:
  url: nats://localhost:4222
  stream: AGENTCANVAS_INGESTION
  subject: agentcanvas.ingestion
  consumer: agentcanvas-workers
  durable: agentcanvas-workers
  ack_wait_seconds: 60

reflection_queue:
  backend: mysql
  stream: AGENTCANVAS_REFLECTION
  subject: agentcanvas.reflection.jobs
  dlq_stream: AGENTCANVAS_REFLECTION_DLQ
  dlq_subject: agentcanvas.reflection.dlq
  durable: reflection-workers
  ack_wait_seconds: 120
  heartbeat_seconds: 30
  lease_seconds: 180
  concurrency: 2
  max_ack_pending: 2
  outbox_batch_size: 100
  outbox_poll_milliseconds: 500
  stream_max_age_days: 30
  stream_max_bytes: 1073741824
  stream_replicas: 1

agent_runtime:
  worker_enabled: true
  worker_concurrency: 2
  lease_seconds: 30
  self_improvement_enabled: true
  memory_review_mode: suggest
  review_worker_concurrency: 1
  review_provider_id: 0
  review_model: ""

tools:
  update_plan:
    enabled: true
  request_user_input:
    enabled: false
  default_mode_request_user_input:
    enabled: false

goals:
  # Null keeps goal budgets unbounded; set a positive value to cap defaults and requests.
  max_goal_token_budget: null

git_workspace:
  enabled: true
  # Every project repository must live under one of these absolute paths.
  # For Docker, mount the same host root into API/worker/pruner and store Project paths as /workspaces/<repo>.
  allowed_roots:
    - /Users/your-name/Projects
  worktree_dir_name: .worktrees
  fetch_timeout_seconds: 5
  fetch_freshness_seconds: 300
  git_command_timeout_seconds: 30
  max_output_bytes: 262144
  file_read_max_chars: 100000
  max_workspaces_per_project: 64
  prune_ttl_hours: 24
  preserve_dirty: true
  preserve_unpushed: true
  auto_init_repository: true
  git_user_name: AgentCanvas
  git_user_email: agentcanvas@localhost

minio:
  endpoint: localhost:9000
  access_key: ${AGENTCANVAS_MINIO_ACCESS_KEY}
  secret_key: ${AGENTCANVAS_MINIO_SECRET_KEY}
  bucket: agentcanvas
  use_ssl: false

retrieval:
  backend: elasticsearch

elasticsearch:
  addresses:
    - http://localhost:9200
  username: ""
  password: ""
  chunk_index: agentcanvas_chunks_v1
  message_index: agentcanvas_messages_v1
  context_index: agentcanvas_context_resources_v1

milvus:
  enabled: true
  address: http://localhost:19530
  token: ""
  collection: agentcanvas_chunks_v2
  dimensions: 0
  m: 16
  ef_construction: 200
  ef_search: 64
  metric_type: COSINE

context_index:
  enabled: false
  worker_enabled: false
  embedding_provider_id: 0
  embedding_model: ""
  batch_size: 50
  poll_milliseconds: 1000
  lease_seconds: 60

ocr:
  enabled: false
  endpoint: http://localhost:8000/ocr
  token: ""
  timeout_seconds: 60

python_bridge:
  enabled: false
  shadow_enabled: false
  allow_experimental_chunking: false
  document_parser: go
  shadow_document_parser: false
  allow_experimental_parsing: false
  fallback_to_go_ocr: true
  target: 127.0.0.1:50051
  auth_token_env: AGENTCANVAS_PYTHON_BRIDGE_TOKEN
  connect_timeout_seconds: 2
  request_timeout_seconds: 30
  max_send_bytes: 8388608
  max_receive_bytes: 2097152
  max_concurrency: 8
  max_document_bytes: 8388608
  allowed_parser_methods:
    - python:langchain_pdf
  allowed_chunk_methods:
    - python:fixed_token
    - python:recursive
    - python:langchain_recursive

security:
  jwt_secret: ${AGENTCANVAS_JWT_SECRET}
  refresh_token_pepper: ${AGENTCANVAS_REFRESH_TOKEN_PEPPER}
  secret_encrypt_key: ${AGENTCANVAS_SECRET_ENCRYPT_KEY}
  access_token_ttl_minutes: 30
  refresh_token_ttl_days: 30

oauth:
  github:
    client_id: "your-github-oauth-app-client-id"
    client_secret: "your-github-oauth-app-client-secret"
    redirect_url: http://localhost:8080/api/v1/auth/github/callback
    scopes:
      - read:user
      - user:email
