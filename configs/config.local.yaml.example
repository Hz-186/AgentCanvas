app:
  name: agentcanvas
  env: local
  port: 8080
  base_url: http://localhost:8080

mysql:
  dsn: root:password@tcp(localhost:3306)/agentcanvas?charset=utf8mb4&parseTime=True&loc=Local
  max_open_conns: 20
  max_idle_conns: 10

redis:
  addr: localhost:6379
  password: ""
  db: 0

queue:
  backend: nats # mysql, redis_stream, or nats
  redis_stream: agentcanvas:jobs
  redis_group: agentcanvas-workers
  redis_consumer: worker

nats:
  url: nats://localhost:4222
  stream: AGENTCANVAS_INGESTION
  subject: agentcanvas.ingestion
  consumer: agentcanvas-workers
  durable: agentcanvas-workers
  ack_wait_seconds: 60

reflection_queue:
  backend: mysql
  stream: AGENTCANVAS_REFLECTION
  subject: agentcanvas.reflection.jobs
  dlq_stream: AGENTCANVAS_REFLECTION_DLQ
  dlq_subject: agentcanvas.reflection.dlq
  durable: reflection-workers
  ack_wait_seconds: 120
  heartbeat_seconds: 30
  lease_seconds: 180
  concurrency: 2
  max_ack_pending: 2
  outbox_batch_size: 100
  outbox_poll_milliseconds: 500
  stream_max_age_days: 30
  stream_max_bytes: 1073741824
  stream_replicas: 1

agent_runtime:
  worker_enabled: true
  worker_concurrency: 2
  lease_seconds: 30
  self_improvement_enabled: true
  memory_review_mode: suggest
  review_worker_concurrency: 1
  review_provider_id: 0
  review_model: ""

minio:
  endpoint: localhost:9000
  access_key: minioadmin
  secret_key: minioadmin
  bucket: agentcanvas
  use_ssl: false

elasticsearch:
  addresses:
    - http://localhost:9200
  username: ""
  password: ""
  chunk_index: agentcanvas_chunks_v1
  message_index: agentcanvas_messages_v1
  context_index: agentcanvas_context_resources_v1

milvus:
  enabled: true
  address: http://localhost:19530
  token: ""
  collection: agentcanvas_chunks
  dimensions: 0
  m: 16
  ef_construction: 200
  ef_search: 64
  metric_type: COSINE

context_index:
  enabled: false
  worker_enabled: false
  embedding_provider_id: 0
  embedding_model: ""
  batch_size: 50
  poll_milliseconds: 1000
  lease_seconds: 60

ocr:
  enabled: false
  endpoint: http://localhost:8000/ocr
  token: ""
  timeout_seconds: 60

security:
  jwt_secret: replace-me-with-long-random-string
  refresh_token_pepper: replace-me-with-another-long-random-string
  secret_encrypt_key: replace-me-with-base64-encoded-32-bytes
  access_token_ttl_minutes: 30
  refresh_token_ttl_days: 30

oauth:
  github:
    client_id: "your-github-oauth-app-client-id"
    client_secret: "your-github-oauth-app-client-secret"
    redirect_url: http://localhost:8080/api/v1/auth/github/callback
    scopes:
      - read:user
      - user:email
